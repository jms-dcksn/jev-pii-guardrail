# UiPath. Get these from `uipath auth` or the Automation Cloud portal.
UIPATH_URL=
UIPATH_ORGANIZATION_ID=
UIPATH_TENANT_ID=
UIPATH_ACCESS_TOKEN=

# TypeSafe (Jev) PII detection guardrail.
# Get a key from https://console.typesafe.ai/settings/keys
# Without it every boundary reports "unchecked": detection is fail-open, and
# the run continues.
TYPESAFE_API_KEY=
# Optional. Defaults below are the ones jev_pii.py applies.
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_PII_THRESHOLD=0.60

# Action Center escalation target. Only the Exception path uses these.
# PRIOR_AUTH_APP_NAME=prior-auth-review-app
# PRIOR_AUTH_APP_FOLDER=Shared
# PRIOR_AUTH_ASSIGNEE=
# PRIOR_AUTH_PRIORITY=High
